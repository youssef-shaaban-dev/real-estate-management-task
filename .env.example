# ──────────────────────────────────────────────────────────────────────────────
# Rent Collection System — Environment Variables
# Copy to .env.local and fill in values from `npx supabase status`
# ──────────────────────────────────────────────────────────────────────────────

# Prisma — direct connection to local Supabase Postgres (from `npx supabase status` → DB URL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Prisma migrations — same as DATABASE_URL for local dev (no connection pooler)
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase — public (safe for browser) — from `npx supabase status` → API URL & anon key
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key from npx supabase status>"

# Supabase — secret (server only, NEVER sent to browser) — from `npx supabase status` → service_role key
SUPABASE_SERVICE_ROLE_KEY="<service_role key from npx supabase status>"

# Gateway webhook signature verification key (shared secret with the payment gateway)
GATEWAY_X_SIGNATURE_KEY="test_x_signature_key"

