# ──────────────────────────────────────────────────────────────────────────────
# Rent Collection System — Environment Variables
# Copy to .env.local and fill in values from `npx supabase status`
# ──────────────────────────────────────────────────────────────────────────────

# Prisma — direct connection to local Supabase Postgres (from `npx supabase status` -> DB URL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Prisma migrations — direct connection to local Supabase Postgres (from `npx supabase status` -> DB URL)
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase API URL (safe for browser) — from `npx supabase status` -> API URL
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"

# Supabase Publishable / Anon Key (safe for browser) — from `npx supabase status` -> anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace_with_anon_key_from_npx_supabase_status"

# Supabase Secret / Service Role Key (SERVER ONLY, NEVER SEND TO BROWSER) — from `npx supabase status` -> service_role key
SUPABASE_SECRET_KEY="replace_with_service_role_key_from_npx_supabase_status"

# Gateway webhook signature verification key (shared secret with payment gateway)
GATEWAY_X_SIGNATURE_KEY="test_x_signature_key"

# ──────────────────────────────────────────────────────────────────────────────
